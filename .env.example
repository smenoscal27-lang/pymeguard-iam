# ==============================================================================
# 🛡️ PymeGuard IAM — Variables de Configuración de Entorno
# ==============================================================================
# Copie este archivo como '.env' en entornos locales o configure estas variables
# en su proveedor de hosting o contenedor antes de desplegar en producción.

# Clave criptográfica para firma y validación de tokens JWT (HS256) y sesiones SSO
# ADVERTENCIA: En producción, utilice una cadena aleatoria de alta entropía (mínimo 32 caracteres).
IAM_SECRET_KEY=clave-desarrollo-cambiar-en-produccion

# Puerto de escucha para el servidor FastAPI (Opcional, por defecto 8000)
PORT=8000

# Host de escucha para el servidor FastAPI (Opcional, por defecto 127.0.0.1)
HOST=127.0.0.1
